{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git pull --ff-only 2>&1 || echo \"UYARI: yerel ve uzak ayrışmış — pull yapılmadı, elle birleştir\"",
            "timeout": 30,
            "statusMessage": "GitHub'dan en son değişiklikler çekiliyor..."
          }
        ]
      }
    ]
  }
}
