rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Uygulamanın yüklediği ek türleri: görsel, PDF, ses ve SUNUM (PPTX).
    // KÖK NEDEN (2026-10-17): sunum türü listede yoktu — ortak nota ya da
    // web'den eklenen sunum Storage'a HİÇ yüklenemiyor (kural reddi), kuyruk
    // onu 6 saate kadar tırmanan aralıklarla boşuna yeniden deniyordu.
    // Görüntülü not ve metin eki (transkript) hiç yüklenmez.
    function attachmentTypes() {
      return 'image/.*|application/pdf|audio/.*'
        + '|application/vnd[.]openxmlformats-officedocument[.]presentationml[.]presentation';
    }

    // Her kullanıcı yalnızca kendi dosyalarına erişebilir.
    // create/update: en fazla 50 MB (premium tavanı) ve yalnızca uygulamanın
    // yüklediği türler (attachmentTypes) — keyfi dosya barındırma kapalı.
    // Ücretsiz 10 MB sınırı uygulama tarafında; sunucu tek tavan (50 MB) tutar.
    //
    // TOPLAM kota (kullanıcı başına 50 MB / 2 GB) BURADA ZORLANAMAZ: Storage
    // kuralları bucket kullanımını toplayamaz/sayamaz. İstemci tavanı
    // AttachmentRepository uygular; sunucu tarafı zorlama Cloud Function
    // (finalize tetikleyicisi + Firestore sayaç) ister — Play Billing öncesi
    // yapılacaklar listesinde (bkz. KALANLAR).
    // delete AYRI tutulur: request.resource silmede null olduğundan boyut
    // koşulu delete'e de uygulanırsa kullanıcı kendi ekini SİLEMEZ
    // (eski kuralın yetim dosya bırakan açığı buydu).
    // **PAYLAŞILAN KLASÖRÜN SOHBET GÖRSELLERİ** (kullanıcı isteği
    // 2026-09-04: "sohbette görsel gönderilebilir olsun").
    //
    // Not ekleri `users/{uid}/…` altında ve YALNIZ sahibine açık; sohbetteki
    // görseli ise klasörün HER ÜYESİ görmeli. Bu yüzden ayrı bir ağaç ve
    // erişim sorusu Firestore'daki paylaşım aynasından (`folderShares`)
    // yanıtlanıyor — aynı soruyu iki yerde iki farklı biçimde yanıtlamamak
    // için (bkz. firestore.rules → folderShare).
    match /folderChats/{folderId}/{fileName} {
      function share() {
        return firestore.get(
          /databases/(default)/documents/folderShares/$(folderId)).data;
      }
      function member() {
        return request.auth != null
          && (request.auth.uid == share().ownerId
              || request.auth.uid in share().get('sharedWith', []));
      }
      allow read: if member();
      // Sohbet bir dosya deposu DEĞİL: 8 MB tavan (istemci de aynı tavanı
      // uyguluyor, bkz. FolderChatRepository.maxImageBytes) ve yalnız görsel.
      allow create, update: if member()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // Silme üyede: mesajı silen kişi dosyayı da siler (mesaj silme yetkisi
      // Firestore tarafında yazarında ve klasör sahibinde).
      allow delete: if member();
    }

    // **PAYLAŞILAN NOTUN EKLERİ** — ortak not (kullanıcı isteği 2026-09-22)
    // ve paylaşılan klasördeki not. Dosyalar notun SAHİBİNİN yolunda durur;
    // ortak çalışan buraya OKUR ve (2026-09-23: "ortak nottaki görsel
    // sorunu") YAZAR — eklediği görsel eskiden kendi yoluna gidiyor, sahip
    // onu hiç göremiyordu. SİLME sahipte kalır (Firestore'daki not silme
    // kuralıyla aynı güvenlik marjı).
    //
    // Soru Firestore'daki aynalardan yanıtlanır (bkz. firestore.rules →
    // noteShares / folderShares). Klasör yolu iki belge okur (not → klasör
    // aynası); ortak not yolu bir.
    match /users/{uid}/notes/{noteId}/{allPaths=**} {
      function noteShare() {
        return /databases/(default)/documents/noteShares/$(uid + '_' + noteId);
      }
      function noteCollaborator() {
        return firestore.exists(noteShare())
          && request.auth.uid in firestore.get(noteShare()).data.get('sharedWith', []);
      }
      function folderRoleOk(roles) {
        let note = firestore.get(
            /databases/(default)/documents/users/$(uid)/notes/$(noteId)).data;
        let folderId = note.get('folderId', null);
        let share = folderId == null ? null : firestore.get(
            /databases/(default)/documents/folderShares/$(folderId)).data;
        return share != null
          && share.ownerId == uid
          && request.auth.uid in share.get('sharedWith', [])
          && share.get('roles', {}).get(request.auth.uid, 'both') in roles;
      }
      allow read: if request.auth != null
        && request.auth.uid != uid
        && (noteCollaborator() || folderRoleOk(['read', 'both']));
      allow create, update: if request.auth != null
        && request.auth.uid != uid
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches(attachmentTypes())
        && (noteCollaborator() || folderRoleOk(['write', 'both']));
    }

    match /users/{uid}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches(attachmentTypes());
    }
  }
}
