rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // `folderShares/{folderId}` aynasını okur — klasör paylaşım kurallarının
    // hepsi aynı iki soruyu sorar ("bu folderId'nin gerçek sahibi kim",
    // "kimlerle paylaşılmış"); tek yerden okumak kopya `get()` çağrılarını
    // ve aralarında tutarsızlık riskini önler.
    function folderShare(folderId) {
      return get(/databases/$(database)/documents/folderShares/$(folderId)).data;
    }

    // Bir kullanıcının o klasördeki YETKİSİ (kullanıcı isteği 2026-08-18:
    // "klasör sahibi paylaşılan klasörde yetki belirleyebilsin yazma, okuma
    // veya her ikisi şeklinde"). `roles` haritası uid → 'read' | 'write' |
    // 'both'. VARSAYILAN 'both': bu alan eklenmeden ÖNCE paylaşılmış
    // klasörlerde herkes okuyup yazıyordu, güncelleme onların erişimini
    // sessizce kesmemeli.
    function folderRole(share, uid) {
      return share.get('roles', {}).get(uid, 'both');
    }

    function canReadFolder(share, uid) {
      return uid in share.get('sharedWith', [])
        && folderRole(share, uid) in ['read', 'both'];
    }

    function canWriteFolder(share, uid) {
      return uid in share.get('sharedWith', [])
        && folderRole(share, uid) in ['write', 'both'];
    }

    // Davetin KABULÜ/REDDİ (kullanıcı isteği 2026-08-18: "klasör
    // paylaşıldığında kabul et veya reddet seçeneği olsun"). Sahip daveti
    // `pending` dizisine bırakır; DAVETLİ kendi kaydını oradan düşürüp
    // (reddetme) ya da `sharedWith`e ekleyerek (kabul) yanıtlar. Yalnız
    // KENDİ satırına dokunabilir: başkasını ekleyemez/çıkaramaz, başka alan
    // (ad, simge, roller, sahiplik) değiştiremez.
    function answersOwnInvite(uid) {
      return uid in resource.data.get('pending', [])
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pending', 'sharedWith'])
        && !(uid in request.resource.data.get('pending', []))
        && resource.data.get('pending', []).toSet()
            .difference(request.resource.data.get('pending', []).toSet())
            .hasOnly([uid])
        // `sharedWith` EN FAZLA kendini kazanır, kimseyi kaybetmez.
        && request.resource.data.get('sharedWith', []).toSet()
            .difference(resource.data.get('sharedWith', []).toSet())
            .hasOnly([uid])
        && resource.data.get('sharedWith', []).toSet()
            .difference(request.resource.data.get('sharedWith', []).toSet())
            .size() == 0;
    }

    // Kullanıcının kök dokümanı (premiumUntil gibi hesap alanları).
    // premiumUntil istemciden YAZILAMAZ: kullanıcı kendi dokümanına
    // premiumUntil yazarak ücretsiz premium alamasın. Alan yalnızca
    // konsoldan/sunucudan (ileride Play Billing Cloud Function) yazılır.
    match /users/{uid} {
      allow read, delete: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && !request.resource.data.keys().hasAny(['premiumUntil']);
      allow update: if signedInAs(uid)
        && !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['premiumUntil']);
    }

    // Her kullanıcı yalnızca kendi verisini okuyup yazabilir. Aşağıdaki DAR
    // istisnalar (arkadaşlık isteği/kabulü, klasör paylaşımı) bu genel
    // kuralın YANINA eklenir — Firestore kuralları OR'lanır: eşleşen
    // herhangi bir blok izin verirse istek geçer. Bu blok sahibin KENDİ
    // erişimini asla daraltmaz.
    match /users/{uid}/{document=**} {
      allow read, write: if signedInAs(uid);
    }

    // **ARKADAŞLIK İSTEĞİ** — kullanıcı isteği 2026-08-18: "kişiler
    // kullanıcıya dışarıdan (e-postayla) belirleyebilmeli." Sunucusuz
    // (Cloud Function yok) bir istek/kabul akışı: GÖNDEREN, ALICININ
    // `friendRequests` alt koleksiyonuna KENDİ kimliğiyle bir doküman
    // bırakır. Yalnız kendi e-postasını/adını yazabilir — başkası adına
    // sahte istek gönderemez.
    match /users/{toUid}/friendRequests/{fromUid} {
      allow read: if request.auth != null
        && (request.auth.uid == toUid || request.auth.uid == fromUid);
      allow create: if request.auth != null
        && request.auth.uid == fromUid
        && request.resource.data.keys().hasOnly(
            ['fromEmail', 'fromName', 'createdAt'])
        && request.resource.data.fromEmail is string
        && request.resource.data.fromName is string;
      // Silme: ALICI reddeder/kabul kaydını temizler, GÖNDEREN isteğini
      // geri çeker — ikisi de kendi payına düşeni kaldırabilir.
      allow delete: if request.auth != null
        && (request.auth.uid == toUid || request.auth.uid == fromUid);
      // Güncelleme YOK: bir istek değiştirilmez, ya silinir ya kabul edilip
      // `friends`e taşınır.
      allow update: if false;
    }

    // **ARKADAŞLIK KAYDI** — normalde `users/{uid}/{document=**}` ile
    // yalnız SAHİBİ yazar. Kabul akışı KARŞILIKLI iki doküman ister: X bana
    // (Y'ye) istek göndermişse (`users/{Y}/friendRequests/{X}`), BEN (Y)
    // kabul ederken hem kendi listeme hem X'in listesine yazmalıyım — bu
    // istisna TAM O tek durumu açar: Y, X'in `friends` alt koleksiyonuna
    // (`users/{ownerUid=X}/friends/{friendUid=Y}`) YALNIZ Y'nin KENDİ
    // gelen kutusunda ("users/{Y}/friendRequests/{X}", yani
    // `users/{friendUid}/friendRequests/{ownerUid}`) karşılığı olan bir
    // istek varsa yazabilir. İsteğin VARLIĞI, X'in bu arkadaşlığa zaten
    // rıza gösterdiğinin kanıtıdır.
    //
    // KÖK NEDEN (ilk taslakta ters yazılmıştı — kendi kendine gözden geçirme
    // sırasında yakalandı): `users/{ownerUid}/friendRequests/{friendUid}`
    // GÖNDERENİN gelen kutusuna bakıyordu, oysa istek her zaman ALICININ
    // (`friendUid`) gelen kutusunda durur. Yanlış yol tüm kabul akışını
    // sessizce reddederdi (exists() hep false).
    match /users/{ownerUid}/friends/{friendUid} {
      allow create: if request.auth != null
        && request.auth.uid == friendUid
        && exists(
            /databases/$(database)/documents/users/$(friendUid)/friendRequests/$(ownerUid))
        && request.resource.data.keys().hasOnly(['email', 'name', 'since'])
        && request.resource.data.email is string
        && request.resource.data.name is string;
      // Kaldırma: iki taraf da (ben ya da arkadaşım) her iki aynayı
      // silebilir — arkadaşlığı bozmak KARŞILIKLI rıza gerektirmez.
      allow delete: if request.auth != null
        && (request.auth.uid == ownerUid || request.auth.uid == friendUid);
      allow update: if false;
    }

    // **KLASÖR PAYLAŞIMI** — kullanıcı isteği 2026-08-18: "ortak notlar
    // klasörü kişiler bağlanır notları ortak görür." Sahip zaten yukarıdaki
    // genel kuralla kendi klasörüne erişiyor; burası yalnız PAYLAŞILAN
    // kullanıcılara EK erişim verir — `sharedWith` dizisinde kendi uid'i
    // varsa VE sahibin verdiği rol (bkz. [folderRole]) o eylemi kapsıyorsa.
    // Klasörü paylaşabilmek/kaldırabilmek ve ROL VERMEK yalnız sahipte kalır;
    // davetliye açılan tek istisna kendi davetini yanıtlamaktır.
    match /users/{ownerUid}/folders/{folderId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.get('sharedWith', []);
      // Paylaşılan kullanıcı klasörün AD/SİMGE/GİZLİLİĞİNİ değiştiremez;
      // paylaşım alanlarının (üyeler, davetler, roller) HİÇBİRİNE de
      // dokunamaz — yoksa kendi rolünü 'read'ten 'both'a yükseltebilirdi.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.get('sharedWith', [])
        && request.resource.data.get('sharedWith', [])
            == resource.data.get('sharedWith', [])
        && request.resource.data.get('pending', [])
            == resource.data.get('pending', [])
        && request.resource.data.get('roles', {})
            == resource.data.get('roles', {});
      // **DAVETİ YANITLAMA.** Klasör dokümanı sahibin arayüzünün doğrusu
      // olduğundan davetli kabul/reddi buraya da yazar (aynaya yazdığının
      // aynısı). Okuma izni GEREKMEZ: istemci `arrayUnion`/`arrayRemove`
      // kullanır, mevcut diziyi hiç görmeden kendi satırını değiştirir.
      allow update: if request.auth != null
        && answersOwnInvite(request.auth.uid);
    }

    // **NOT ERİŞİMİ — paylaşılan klasörün içi.** Sahip zaten genel kuralla
    // erişiyor; burası notun BAĞLI OLDUĞU klasörün paylaşıldığı kullanıcıya
    // ek erişim verir. `folderId` sahibi kim olursa olsun `folderShares`
    // KÖK aynasından çözülür (bkz. aşağıdaki koleksiyon) — bu sayede notun
    // hangi kullanıcının altında olduğu ile klasörün sahibi FARKLI
    // olabilir (paylaşılan kişi klasöre kendi notunu eklerse bile not,
    // klasörün SAHİBİNİN koleksiyonuna yazılır — istemci tarafı zaten böyle
    // kurgulandı, bkz. FolderScreen/_SharedFolderView).
    match /users/{noteOwnerUid}/notes/{noteId} {
      // **SAHİP EŞLEŞMESİ ZORUNLU** (kendi kendine gözden geçirmede
      // yakalandı): yalnız "bu folderId bana paylaşılmış mı" sormak
      // YETMEZ — `noteOwnerUid` (yol parçası, JOKER) ile aynanın gerçek
      // `ownerId`sinin AYNI olduğu da doğrulanmalı. Yoksa A, KENDİSİYLE
      // paylaşılmış herhangi bir klasörün folderId'sini kullanarak
      // `users/{KURBAN}/notes/{yeni}` yoluna keyfi not YAZABİLİR ya da
      // kurbanın folderId'si tesadüfen eşleşen bir notunu OKUYABİLİRDİ —
      // kurbanın o klasörle hiçbir ilgisi olmasa bile.
      //
      // **ROL AYRIMI** (kullanıcı isteği 2026-08-18): okuma ve yazma artık
      // ayrı sorular. 'read' rolündeki kullanıcı notu GÖRÜR ama
      // değiştiremez; 'write' rolündeki (öneri kutusu gibi) notunu bırakır
      // ama başkasınınkini okuyamaz; 'both' ikisini de yapar.
      allow read: if request.auth != null
        && resource.data.folderId != null
        && folderShare(resource.data.folderId).ownerId == noteOwnerUid
        && canReadFolder(folderShare(resource.data.folderId), request.auth.uid);
      allow update: if request.auth != null
        && resource.data.folderId != null
        && folderShare(resource.data.folderId).ownerId == noteOwnerUid
        && canWriteFolder(folderShare(resource.data.folderId), request.auth.uid)
        // Not paylaşılan klasörden ÇIKARILAMAZ: `folderId` değişseydi
        // (ya da null olsaydı) yazma yetkisi olan kişi, klasörü kaynak alıp
        // sahibinin başka bir notunu bu kuralın kapsamına sokabilir ya da
        // notu sahibinin erişemediği bir yere taşıyabilirdi.
        && request.resource.data.folderId == resource.data.folderId;
      allow create: if request.auth != null
        && request.resource.data.folderId != null
        && folderShare(request.resource.data.folderId).ownerId == noteOwnerUid
        && canWriteFolder(
            folderShare(request.resource.data.folderId), request.auth.uid);
      // Kalıcı silme (`hardDelete`) paylaşılan kullanıcıya AÇIK DEĞİL —
      // yalnız güncelleme (biçim, düzenleme, çöpe taşıma). Başkasının notunu
      // GERİ DÖNÜŞSÜZ silme yetkisi sahipte kalır; bu bilinçli bir
      // güvenlik marjı, "herkes düzenler" kararının kapsamadığı tek eylem.
      allow delete: if false;
    }

    // **KLASÖR PAYLAŞIM AYNASI** — `folderShares/{folderId}`, kimliği
    // `users/{ownerId}/folders/{folderId}` ile AYNI. Paylaşılan kullanıcının
    // "bana hangi klasörler açıldı" sorusunu TEK sorguda yanıtlar
    // (`sharedWith` dizisinde `array-contains`) ve yukarıdaki not kuralının
    // "bu folderId kime ait, kimlerle paylaşılmış" ARAMASINI besler. Yalnız
    // SAHİP yazabilir; ad/simge SENKRON kopyası olduğundan (bkz.
    // FoldersRepository.updateFolder) klasörün asıl doğrusu her zaman
    // `users/{ownerId}/folders/{folderId}`dedir.
    match /folderShares/{folderId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
            || request.auth.uid in resource.data.get('sharedWith', [])
            // Davetli, daveti GÖRMEK için okuyabilmeli — kabul/ret ekranı
            // klasörün adını ve kimin paylaştığını buradan alır.
            || request.auth.uid in resource.data.get('pending', []));
      // **SAHİPLİK KANITI ZORUNLU** (kendi kendine gözden geçirmede
      // yakalandı): yalnız `ownerId == request.auth.uid` demek YETMEZ —
      // `folderShares` AYRI bir kök koleksiyon olduğundan, bu şart tek
      // başına herhangi bir kullanıcının RASTGELE bir folderId için sahte
      // bir ayna dokümanı yaratıp KENDİSİNİ `sharedWith`e ekleyerek o
      // klasörün (ve içindeki notların) gerçek sahibi gibi davranmasına
      // izin verirdi — yukarıdaki not kuralı yalnız bu aynaya bakıyor,
      // gerçek klasörün var olup olmadığına DEĞİL. `exists()` şartı,
      // yazan kişinin `users/{kendi_uid}/folders/{folderId}` altında GERÇEK
      // bir klasöre sahip olduğunu (yani gerçekten o klasörün sahibi
      // olduğunu) doğrular.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && exists(
            /databases/$(database)/documents/users/$(request.auth.uid)/folders/$(folderId))
        && request.resource.data.keys().hasOnly(
            ['ownerId', 'name', 'icon', 'sharedWith', 'pending', 'roles'])
        && request.resource.data.sharedWith is list;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerId
        && request.auth.uid == request.resource.data.ownerId
        && exists(
            /databases/$(database)/documents/users/$(request.auth.uid)/folders/$(folderId))
        && request.resource.data.keys().hasOnly(
            ['ownerId', 'name', 'icon', 'sharedWith', 'pending', 'roles']);
      // **DAVETİ YANITLAMA** — bkz. [answersOwnInvite]. Davetli yalnız
      // kendini `pending`den düşürür (ret) ya da `sharedWith`e taşır
      // (kabul); rolünü kendisi seçemez, sahibin verdiği rol neyse odur.
      allow update: if request.auth != null
        && answersOwnInvite(request.auth.uid);
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }

    // **PAYLAŞILAN KLASÖRÜN SOHBETİ** — kullanıcı isteği 2026-08-18:
    // "birde birbirine mesaj gönderme alanı olabilir." Mesajlar klasörün
    // KENDİSİNİN altında değil AYNANIN altında durur: erişim sorusunun
    // ("bu klasöre kim bakabilir") cevabı zaten aynada ve tek `get()` ile
    // çözülür; klasörün altında olsalardı sahibin koleksiyonuna yazma
    // yetkisi gerekirdi.
    //
    // Yetki AYRIMI YOK (bilinçli): 'read' rolündeki kullanıcı da yazabilir.
    // Rol NOTLAR için verilmiş bir yetkidir; "notlara dokunma ama soru sor"
    // sohbetin var olma nedeni.
    match /folderShares/{folderId}/messages/{messageId} {
      allow read: if request.auth != null
        && (request.auth.uid == folderShare(folderId).ownerId
            || request.auth.uid
                in folderShare(folderId).get('sharedWith', []));
      allow create: if request.auth != null
        && (request.auth.uid == folderShare(folderId).ownerId
            || request.auth.uid
                in folderShare(folderId).get('sharedWith', []))
        && request.resource.data.senderId == request.auth.uid
        // GÖRSELLİ MESAJ (kullanıcı isteği 2026-09-04): dosyanın kendisi
        // Storage'da (`folderChats/{folderId}/…`, bkz. storage.rules);
        // mesajda yalnız indirme adresi ve yol durur.
        && request.resource.data.keys().hasOnly(
            ['senderId', 'senderName', 'text', 'createdAt',
             'imageUrl', 'imagePath'])
        && request.resource.data.text is string
        // Metin BOŞ olabilir — ama o zaman görsel olmalı: içi de dışı da
        // boş bir mesaj sohbete çöp düşürmenin en ucuz yolu olurdu.
        && (request.resource.data.text.size() > 0
            || request.resource.data.get('imageUrl', '').size() > 0)
        // Tavan: mesaj alanı bir dosya taşıyıcısına çevrilmesin.
        && request.resource.data.text.size() <= 2000
        && request.resource.data.get('imageUrl', '') is string
        && request.resource.data.get('imageUrl', '').size() <= 1000
        && request.resource.data.get('imagePath', '') is string
        && request.resource.data.get('imagePath', '').size() <= 500
        && request.resource.data.senderName is string;
      // Mesaj DEĞİŞTİRİLEMEZ (gönderilmiş söz geri alınır, düzeltilmez);
      // silmek yazarında ve klasör sahibinde.
      allow update: if false;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.senderId
            || request.auth.uid == folderShare(folderId).ownerId);
    }

    // **GELEN NOTLAR** — kullanıcı isteği 2026-08-18: "not paylaş seçeneği de
    // lazım, paylaşılan not alıcıda farklı 'gelen notlar' klasöründe
    // görülsün ve oradan normal dashboard'a taşınabilsin."
    //
    // Not, alıcının `inboxNotes` alt koleksiyonuna KOPYA olarak bırakılır
    // (klasör paylaşımı gibi canlı bağ DEĞİL: gönderilen not gönderenin
    // notundan bağımsızdır, alıcı kabul edince kendi notu olur). Yalnız
    // ARKADAŞ gönderebilir: `users/{alıcı}/friends/{gönderen}` dokümanının
    // varlığı, alıcının bu kişiyi kabul ettiğinin kanıtıdır — yoksa herkes
    // herkese not yağdırabilirdi.
    match /users/{toUid}/inboxNotes/{inboxId} {
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && exists(
            /databases/$(database)/documents/users/$(toUid)/friends/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(
            ['fromUid', 'fromName', 'fromEmail', 'sentAt',
             'title', 'body', 'items', 'type', 'tags', 'color'])
        && request.resource.data.title is string
        && request.resource.data.body is string
        // Tavan: gelen kutusu başkasının deposu olmasın (alıcı kotasına
        // yazılıyor). Firestore doküman sınırı zaten ~1 MiB.
        && request.resource.data.title.size() <= 500
        && request.resource.data.body.size() <= 100000;
      // Okuma/silme ALICIYA ait ve zaten `users/{uid}/{document=**}` genel
      // kuralıyla var; gönderen yolladığını geri alamaz, değiştiremez.
      allow update: if false;
    }

    // **E-POSTA DİZİNİ** — `userDirectory/{eposta}` = `{uid}`. Arkadaş
    // eklemek isteyen kullanıcı bir e-postadan uid'e buradan ulaşır. Her
    // kullanıcı yalnız KENDİ e-postasının kaydını yazabilir (doküman
    // kimliğinin küçük harfli e-postasıyla eşleştiği ve `uid`in kendisi
    // olduğu doğrulanır) — başkası adına sahte yönlendirme kaydı bırakamaz.
    // Okuma herkese (giriş yapmış) açık: e-postadan arama BUNU gerektirir,
    // ama yalnız `get` (tek doküman) — `list` YASAK, aksi hâlde dizinin
    // TAMAMI (kayıtlı her e-posta) taranabilirdi.
    match /userDirectory/{email} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // **KULLANICI ARAMA DİZİNİ** — arkadaş eklemede "tüm kullanıcılar
    // içinde arama" (kullanıcı isteği 2026-08-21). `userDirectory`'nin
    // aksine bu koleksiyon istemciden HİÇ okunamaz — ne `get` ne `list`.
    // Okuma yalnız `functions/searchUsers` callable'ından Admin SDK ile
    // olur (kuralları atlar, ama sonucu 15 kayıtla ve önek eşleşmesiyle
    // sınırlar) — aksi hâlde herkese `get` açık `userDirectory` deseniyle
    // aynı yolu izleseydik, e-posta yerine ad araması TÜM kullanıcı
    // tabanının brute-force taranmasını mümkün kılardı (e-posta zaten
    // bilinmesi gereken bir sır, ama isim öneki değil). Yazma yalnız
    // KENDİ dokümanına.
    match /userSearch/{uid} {
      allow get, list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(
          ['uid', 'name', 'email', 'nameLower', 'emailLower']
        );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Dahili AI kota sayacı. AYRI KÖK KOLEKSİYONDA, bilerek:
    //
    // KÖK NEDEN (iki ayrı açık, ikisi de faturayı projeye çıkarıyordu):
    // (1) Sayaç `users/{uid}` içindeydi ve o doküman istemciden SİLİNEBİLİYOR
    //     (hesap silme akışı için gerekli). Silip yeniden yaratmak sayacı
    //     sıfırlıyordu.
    // (2) Daha büyüğü: gün bilgisi istemcinin yazdığı bir METİNDİ
    //     ('2026-08-02') ve kural "gün değiştiyse sayaç sıfırlanabilir"
    //     diyordu. Yani istemci her istekte uydurma bir gün yazarak kotayı
    //     hiç doldurmadan sınırsız AI kullanabilirdi — silmeye bile gerek yok.
    //
    // ÇÖZÜM: pencere damgası artık SUNUCU zamanı (`request.time`); istemci
    // uyduramaz. Sayaç aynı pencerede yalnız ARTAR, pencere ancak sunucu
    // saatine göre 24 saat geçtiyse sıfırlanır. Doküman silinemez.
    //
    // KARAR (takas): kota "gece yarısı" yerine "son sıfırlamadan 24 saat
    // sonra" yenilenir. Takvim gününü kurallarda güvenle hesaplamak
    // (saat dilimi + metin biçimlendirme) mümkün değil; kayan pencere hem
    // güvenli hem kullanıcı açısından adil.
    match /aiQuota/{uid} {
      allow read: if signedInAs(uid);

      // Yalnız iki alan yazılabilir ve puana mutlak tavan var: doküman
      // silinemez olduğundan buraya konan keyfi alan/şişkin veri de kalıcı
      // olurdu. Tavan, premium günlük hakkın (300) rahat üstünde tutuldu ki
      // limit artışında kuralı güncellemeyi unutmak AI'ı kilitlemesin.
      allow create: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['dayStart', 'points'])
        && request.resource.data.dayStart == request.time
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= 1000;

      allow update: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['dayStart', 'points'])
        && request.resource.data.points is int
        && request.resource.data.points <= 1000
        && (
          // Aynı pencere: puan yalnız ARTABİLİR. Katı `>` şart — `>=` eşit
          // değeri de geçiriyordu, değiştirilmiş bir istemci sayacı hep aynı
          // değerde yazarak kotayı hiç doldurmadan sınırsız AI kullanabilirdi
          // (fatura projeye çıkar; AiGate.consume her çağrıda en az 1 ekler,
          // meşru istemci `>`'a hiç takılmaz).
          (request.resource.data.dayStart == resource.data.dayStart
            && request.resource.data.points > resource.data.points)
          // Yeni pencere: damga sunucudan gelmeli VE eskisi 24 saati doldurmalı.
          || (request.resource.data.dayStart == request.time
            && resource.data.dayStart < request.time - duration.value(24, 'h')
            && request.resource.data.points >= 0)
        );

      // Silme YOK: silip yeniden yaratmak sayacı sıfırlamanın en kolay yolu.
      // Uid'ler yeniden kullanılmadığından hesap silinince artakalan sayaç
      // (bir sayı + bir zaman damgası) kimseye ait değildir.
      allow delete: if false;
    }
  }
}
