<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Ölçüm derlemesi varsayılan dikey: masadaki telefonun sensörü yan
             dönünce (2026-11-04) senaryoların koordinatları ve sütun sayısı
             değişiyordu. Tablette yatay ölçüm: NOTLAR_OLCUM_YON=landscape
             (TP-F; build.gradle.kts `olcumYon`). -->
        <activity android:name=".MainActivity"
            android:screenOrientation="${olcumYon}"
            tools:node="merge"/>
    </application>
</manifest>
