<?xml version="1.0" encoding="utf-8"?>
<!-- YALNIZ KİŞİSEL DERLEME (NOTLAR_KISISEL=1): Harita ve Kanallarım'ın not köprüsü
     (HaritaNotlari.kt). Genel APK'da bu dosya yoktur; CI genel manifesti denetler. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Uygulamalar farklı anahtarla imzalı: signature yetmez, knownSigner (Android 12+) -->
    <permission
        android:name="dev.kaimau.notlar.izin.ASISTAN"
        android:protectionLevel="signature|knownSigner"
        android:knownCerts="@array/kopru_sertifikalari" />

    <!-- Acil hatırlatıcı tam ekran (ReminderLevel.urgent). Play'de beyan ister:
         yalnız kişisel derlemede. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Uygulama içi güncelleme (2026-11-09): indirilen APK'yı sistemin kurulum
         penceresine verir. Play'de kısıtlı izin: yalnız kişisel derlemede. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <receiver android:name=".HaritaNotAlici"
            android:exported="true"
            android:permission="dev.kaimau.notlar.izin.ASISTAN">
            <intent-filter>
                <action android:name="dev.kaimau.notlar.HARITA_NOT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
