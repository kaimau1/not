<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ŞABLON (P84): bu dosya kaynak DEĞİL. `targetPackage` kaynak başvurusu
         almaz (sistem kısayol intent'ini kendi kaynaklarıyla çözer), sabit ad ise
         ölçüm (`.olcum`) ve Play derlemesinde yanlış uygulamayı açıyordu.
         build.gradle.kts `KisayolUret` her çeşit için `${applicationId}`yi gerçek
         kimlikle değiştirip res/xml/app_shortcuts.xml olarak üretir. -->
    <!-- HE-3 (PLAN §1.4/3): HIZLI EKLE levhası, uygulamayı açmadan ekle.
         router.dart › notlar://ekle. En başta: başlatıcı ilk 4'ü gösterir. -->
    <shortcut
        android:shortcutId="quick_add"
        android:enabled="true"
        android:icon="@android:drawable/ic_input_add"
        android:shortcutShortLabel="@string/hizli_ekle"
        android:shortcutLongLabel="@string/hizli_ekle_uzun">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="notlar://ekle"
            android:targetPackage="${applicationId}"
            android:targetClass="dev.kaimau.notlar.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="voice_note"
        android:enabled="true"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="notlar://voice"
            android:targetPackage="${applicationId}"
            android:targetClass="dev.kaimau.notlar.MainActivity" />
    </shortcut>
    <!-- router.dart › notlar://new?type=… (Hızlı Eylemler widget'ıyla aynı yol) -->
    <shortcut
        android:shortcutId="new_note"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_edit"
        android:shortcutShortLabel="@string/widget_qa_new_note">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="notlar://new?type=text"
            android:targetPackage="${applicationId}"
            android:targetClass="dev.kaimau.notlar.MainActivity" />
    </shortcut>
    <!-- router.dart › notlar://new?type=… (Hızlı Eylemler widget'ıyla aynı yol) -->
    <shortcut
        android:shortcutId="new_checklist"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_agenda"
        android:shortcutShortLabel="@string/widget_qa_checklist">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="notlar://new?type=checklist"
            android:targetPackage="${applicationId}"
            android:targetClass="dev.kaimau.notlar.MainActivity" />
    </shortcut>
    <!-- router.dart › notlar://new?type=draw: boş not "Sayfaya yaz (kalem)" kipinde -->
    <shortcut
        android:shortcutId="new_pen"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_edit"
        android:shortcutShortLabel="@string/shortcut_pen_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="notlar://new?type=draw"
            android:targetPackage="${applicationId}"
            android:targetClass="dev.kaimau.notlar.MainActivity" />
    </shortcut>
</shortcuts>
