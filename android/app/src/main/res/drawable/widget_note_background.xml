<?xml version="1.0" encoding="utf-8"?>
<!-- Hızlı Not widget'ının zemini. Mikrofon widget'ıyla aynı düz yapı, farklı
     ton: mikrofon primary, bu primaryContainer. İki widget yan yanayken
     ayırt edilebilsin diye ayrıldı — ikisi de aynı kağıt paletinden geldiği
     için yine de birbirine ve uygulamaya uyumlu kalır.
     Gradyan yeni tasarım diliyle kaldırıldı; bkz. widget_mic_background.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_note" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_outline" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
