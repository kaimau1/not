<?xml version="1.0" encoding="utf-8"?>
<!-- Not listesindeki her satırın kendi kartı. Eskiden dört başlık tek bir
     TextView içinde "•" ile birleştirilmiş düz metindi; okuma sırası
     kayboluyordu. Kart, satırları birbirinden görsel olarak ayırır ve
     widget'a Material You'nun katmanlı yüzey hissini verir.

     Yarıçap İÇ yarıçaptır (widget_inner_radius): iç içe köşelerde dış
     köşeden küçük olması gerekir, aynı olursa kart kenara yapışık görünür. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_row" />
    <corners android:radius="@dimen/widget_inner_radius" />
</shape>
