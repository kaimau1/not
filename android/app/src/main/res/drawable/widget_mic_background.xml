<?xml version="1.0" encoding="utf-8"?>
<!-- Mikrofon widget'ı zemini. Eskiden tek düz renkti ve duvar kâğıdının
     üstünde yassı duruyordu. Şimdi iki katman var:
       1) köşegen gradyan — yüzeye hacim verir
       2) ince açık kenar hattı — camsı bir çerçeve, ikonu duvar kâğıdından
          ayırır (koyu duvar kâğıdında sınır kaybolmasın diye)
     Yuvarlaklık 28dp: 1x1'de daireye yakın, 2x1'e büyütülünce hap biçimi.
     Koyu tema karşılığı drawable-night/ altında. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#3B48AE"
                android:startColor="#6C7BF0"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#38FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
