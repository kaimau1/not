<?xml version="1.0" encoding="utf-8"?>
<!-- Sesli Not widget'ının zemini: düz dolgu + 1px kenar hattı.
     Köşegen gradyan KALDIRILDI — yeni tasarım dilinde gradyan ve gölge yok,
     yüzeyler düz, ayrım outlineVariant kenarlıkla yapılıyor. Kenar hattı
     ikonu duvar kâğıdından ayırdığı için korundu.
     Renk belirteçten geliyor (kağıt paleti; bkz. values/colors.xml).
     Yuvarlaklık Android 12+ cihazda hâlâ launcher'ın kendi widget yarıçapı —
     diğer widget'larla hizalanır.
     Gece/gündüz ayrımı belirtecin işi olduğundan drawable-night/ kopyası yok. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_accent" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_outline" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
