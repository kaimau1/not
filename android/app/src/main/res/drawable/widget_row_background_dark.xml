<?xml version="1.0" encoding="utf-8"?>
<!-- ÜRETİLMİŞ İKİZ: temel çizimin (widget_row_background.xml) belirli bir palete SABİTLENMİŞ
     hâli. Sağlayıcı, kullanıcı uygulamada sistemden farklı bir tema seçtiğinde
     bunu çalışma anında uygular (bkz. WidgetTheme.kt); temel çizim yalnız
     "sistem" seçiliyken kullanılır. Temel çizim değişirse ikizleri de değişmeli. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_dark_row" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_dark_outline" />
    <corners android:radius="@dimen/widget_inner_radius" />
</shape>
