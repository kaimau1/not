<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "sıralı liste" simgesi: solda 1-2-3 basamakları, sağda satırlar.
     Stok @android:drawable/ic_menu_sort_by_size yerine geldi (o bir sıralama
     simgesiydi, numaralı liste değil — yanlış anlam veriyordu).

     Basamaklar 24dp'de okunaklı kalsın diye çizgi (stroke) ile kuruldu;
     rakam yolları bu boyutta lapa gibi görünüyordu. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- "1": eğik bayrak + dikey gövde -->
    <path
        android:pathData="M2.6,5 l1.5,-1 v5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- "2": üst köşe, çapraz iniş, taban -->
    <path
        android:pathData="M2.6,14.2 l1,-0.9 h1.2 l0.7,0.9 v0.8 l-2.9,3.2 h3"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Satırlar -->
    <path
        android:pathData="M10,7 h11"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M10,17 h11"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
</vector>
