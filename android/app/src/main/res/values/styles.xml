<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Açılış teması (DENEYIM F78.1, K-D8): androidx core-splashscreen. Zemin
         uygulamanın zemin rengi (gece karşılığı values-night/colors.xml), simge
         uygulama simgesi; ilk Flutter karesine dek ekranda kalır
         (MainActivity.onCreate), sonra NormalTheme'e geçer. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_bg</item>
    </style>

    <!-- Not listesi widget'ındaki bir not satırı. Dört satır aynı görünür;
         ortak stil olmadan aynı sekiz nitelik dört kez tekrarlanıyordu ve
         biri değişince diğerleri geride kalıyordu. -->
    <style name="WidgetNoteRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/widget_row_background</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_on_surface</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
