<?xml version="1.0" encoding="utf-8"?>
<!-- Widget renk belirteçleri — AÇIK tema, TÜM cihazlar.

     Widget'ların tüm renkleri bu belirteçlerden okunur; çizimler (drawable)
     ve düzenler (layout) ham hex taşımaz. Gece karşılığı values-night/.

     TEMA_PLANI F35.1 (2026-11-04): renkler Adaçayı ailesinden (kâğıt kart
     #FAFCFA, petrol vurgu #106561); gece karşılığı Adaçayı koyu. Simge
     (ic_launcher_*) bilerek değişmedi (K6).

     KARAR (i1 simge çalışması): burası eskiden yalnızca Android 12 öncesi
     YEDEKti; 12+ cihazda values-v31/colors.xml aynı adları duvar kâğıdından
     türeyen sistem renklerine (Material You) bağlıyordu. O bağ kaldırıldı,
     çünkü marka kağıt paletine geçti ve kağıt artık uygulamanın VARSAYILAN
     teması (settings_providers.dart / AppThemeChoice.paper, tohum #8A6C3C):
     simge, uygulama ve widget'ın aynı paleti giymesi duvar kâğıdına uyumdan
     önce geldi. Bedeli bilinçli — widget artık duvar kâğıdıyla değişmiyor.
     Şekil tarafı hâlâ sisteme bağlı: values-v31/dimens.xml köşe yarıçapını
     launcher'ın kendi değerinden alır, o kaldı.

     Vurgu artık TEK renk: yeni tasarım dilinde gradyan yok, düz dolgu +
     1px kenar var. Bu yüzden eski _start/_end çiftleri tek belirtece indi. -->
<resources>
    <!-- Yüzeyler: surface / surfaceContainerLow / outlineVariant -->
    <color name="widget_surface">#FAFCFA</color>
    <color name="widget_row">#EFF4F0</color>
    <color name="widget_outline">#D1D8D2</color>

    <!-- Metin: onSurface / onSurfaceVariant -->
    <color name="widget_on_surface">#1B2420</color>
    <color name="widget_on_surface_muted">#4D5853</color>

    <!-- Vurgu: mikrofon / sesli not — primary + onPrimary -->
    <color name="widget_accent">#106561</color>
    <color name="widget_on_accent">#FFFFFF</color>

    <!-- İkincil vurgu: hızlı not — primaryContainer + onPrimaryContainer.
         Mikrofonla yan yana dururken ayırt edilsin diye daha açık tonda. -->
    <color name="widget_note">#C8E9E6</color>
    <color name="widget_on_note">#002E2C</color>

    <!-- Hızlı eylemler çubuğundaki ikonlar -->
    <color name="widget_icon">#1B2420</color>
    <color name="widget_icon_accent">#106561</color>

    <!-- flutter_launcher_icons tarafından yazılır (adaptive_icon_background). -->
    <color name="ic_launcher_background">#3A2FC9</color>

    <!-- ============================================================
         AÇIK/KOYU AÇIK AÇIK (niteleyicisiz) ikizler.

         Yukarıdaki belirteçler SİSTEM gece moduna göre seçilir
         (values-night/). Ama tema uygulamanın kendi ayarından da gelebilir:
         kullanıcı uygulamada Koyu seçip telefon açık modda kalırsa widget
         kağıt duruyordu. Sağlayıcı o durumda rengi ÇALIŞMA ANINDA uyguluyor
         (bkz. WidgetTheme.kt) ve bunun için niteleyiciye BAĞLI OLMAYAN,
         iki paleti de aynı anda okunabilen adlara ihtiyacı var.

         Değerler yukarıdaki (açık) ve values-night/ (koyu) ile birebir aynı;
         biri değişirse ikizi de değişmeli.
         ============================================================ -->
    <color name="widget_light_surface">#FAFCFA</color>
    <color name="widget_light_row">#EFF4F0</color>
    <color name="widget_light_outline">#D1D8D2</color>
    <color name="widget_light_on_surface">#1B2420</color>
    <color name="widget_light_on_surface_muted">#4D5853</color>
    <color name="widget_light_accent">#106561</color>
    <color name="widget_light_on_accent">#FFFFFF</color>
    <color name="widget_light_note">#C8E9E6</color>
    <color name="widget_light_on_note">#002E2C</color>
    <color name="widget_light_icon">#1B2420</color>
    <color name="widget_light_icon_accent">#106561</color>

    <color name="widget_dark_surface">#1C221E</color>
    <color name="widget_dark_row">#29302C</color>
    <color name="widget_dark_outline">#383F3B</color>
    <color name="widget_dark_on_surface">#E1E8E4</color>
    <color name="widget_dark_on_surface_muted">#B1BAB5</color>
    <color name="widget_dark_accent">#76CDC5</color>
    <color name="widget_dark_on_accent">#002E2B</color>
    <color name="widget_dark_note">#0B4A46</color>
    <color name="widget_dark_on_note">#C8E9E5</color>
    <color name="widget_dark_icon">#E1E8E4</color>
    <color name="widget_dark_icon_accent">#76CDC5</color>
    <!-- Açılış zemini (LaunchTheme + NormalTheme): AppTheme Adaçayı zemini. -->
    <color name="launch_bg">#EAF0EB</color>
</resources>
