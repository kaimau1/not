<?xml version="1.0" encoding="utf-8"?>
<!-- Widget renk belirteçleri — AÇIK tema, TÜM cihazlar.

     Widget'ların tüm renkleri bu belirteçlerden okunur; çizimler (drawable)
     ve düzenler (layout) ham hex taşımaz. Gece karşılığı values-night/.

     KARAR (i1 simge çalışması): burası eskiden yalnızca Android 12 öncesi
     YEDEKti; 12+ cihazda values-v31/colors.xml aynı adları duvar kâğıdından
     türeyen sistem renklerine (Material You) bağlıyordu. O bağ kaldırıldı,
     çünkü marka kağıt paletine geçti ve kağıt artık uygulamanın VARSAYILAN
     teması (settings_providers.dart / AppThemeChoice.paper, tohum #8A6C3C):
     simge, uygulama ve widget'ın aynı paleti giymesi duvar kâğıdına uyumdan
     önce geldi. Bedeli bilinçli — widget artık duvar kâğıdıyla değişmiyor.
     Şekil tarafı hâlâ sisteme bağlı: values-v31/dimens.xml köşe yarıçapını
     launcher'ın kendi değerinden alır, o kaldı.

     Vurgu artık TEK renk: yeni tasarım dilinde gradyan yok, düz dolgu +
     1px kenar var. Bu yüzden eski _start/_end çiftleri tek belirtece indi. -->
<resources>
    <!-- Yüzeyler: surface / surfaceContainerLow / outlineVariant -->
    <color name="widget_surface">#F5EDD8</color>
    <color name="widget_row">#F0E6CC</color>
    <color name="widget_outline">#CFC5B8</color>

    <!-- Metin: onSurface / onSurfaceVariant -->
    <color name="widget_on_surface">#1F1B16</color>
    <color name="widget_on_surface_muted">#4E453B</color>

    <!-- Vurgu: mikrofon / sesli not — primary + onPrimary -->
    <color name="widget_accent">#7D5703</color>
    <color name="widget_on_accent">#FFF8EE</color>

    <!-- İkincil vurgu: hızlı not — primaryContainer + onPrimaryContainer.
         Mikrofonla yan yana dururken ayırt edilsin diye daha açık tonda. -->
    <color name="widget_note">#FFDDAE</color>
    <color name="widget_on_note">#261A01</color>

    <!-- Hızlı eylemler çubuğundaki ikonlar -->
    <color name="widget_icon">#1F1B16</color>
    <color name="widget_icon_accent">#7D5703</color>

    <!-- flutter_launcher_icons tarafından yazılır (adaptive_icon_background). -->
    <color name="ic_launcher_background">#F5EDD8</color>
</resources>
