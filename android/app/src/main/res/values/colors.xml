<?xml version="1.0" encoding="utf-8"?>
<!-- Widget renk belirteçleri — AÇIK tema, Android 12 ÖNCESİ cihazlar.

     Widget'ların tüm renkleri bu belirteçlerden okunur; çizimler (drawable)
     ve düzenler (layout) artık ham hex taşımaz. Android 12+ karşılığı
     values-v31/ altındadır ve aynı adları duvar kâğıdından türeyen sistem
     renklerine (Material You) bağlar — dosyaların geri kalanı değişmez.

     Buradaki değerler o yeteneğin olmadığı cihazlar için YEDEKtir; eski
     widget'ların sabit paletiyle aynı tutuldu. -->
<resources>
    <!-- Yüzeyler -->
    <color name="widget_surface">#F4F3F8</color>
    <color name="widget_row">#FFFFFF</color>
    <color name="widget_outline">#1F000000</color>

    <!-- Metin -->
    <color name="widget_on_surface">#16161A</color>
    <color name="widget_on_surface_muted">#5A5A66</color>

    <!-- Vurgu: mikrofon / sesli not (mavi aile) -->
    <color name="widget_accent_start">#6C7BF0</color>
    <color name="widget_accent_end">#3B48AE</color>
    <color name="widget_on_accent">#FFFFFF</color>

    <!-- İkincil vurgu: hızlı not (ana ekranda mikrofonla karışmasın diye
         ayrı hue; Android 12+ karşılığı system_accent3, yani üçüncül renk) -->
    <color name="widget_note_start">#41C77D</color>
    <color name="widget_note_end">#2E9E63</color>
    <color name="widget_on_note">#FFFFFF</color>

    <!-- Hızlı eylemler çubuğundaki ikonlar -->
    <color name="widget_icon">#16161A</color>
    <color name="widget_icon_accent">#3B48AE</color>
</resources>
