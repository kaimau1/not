<?xml version="1.0" encoding="utf-8"?>
<!-- Material You (Android 12+, AÇIK tema): widget renkleri kullanıcının
     duvar kâğıdından türetilen sistem paletine bağlanır. Widget artık sabit
     bir markanın rengini değil, telefonun o anki temasını giyer — ana ekranda
     "yerli" duran tek yol budur.

     Kullanılan aileler:
       system_accent1  → birincil (mikrofon / sesli not)
       system_accent3  → üçüncül (hızlı not — birincilden ayrı hue)
       system_neutral1 → yüzey ve metin
     Sayı büyüdükçe renk KOYULAŞIR (0 = beyaz, 1000 = siyah). -->
<resources>
    <color name="widget_surface">@android:color/system_accent1_100</color>
    <color name="widget_row">@android:color/system_accent1_50</color>
    <color name="widget_outline">@android:color/system_accent1_200</color>

    <color name="widget_on_surface">@android:color/system_neutral1_900</color>
    <color name="widget_on_surface_muted">@android:color/system_neutral2_700</color>

    <color name="widget_accent_start">@android:color/system_accent1_600</color>
    <color name="widget_accent_end">@android:color/system_accent1_700</color>
    <color name="widget_on_accent">@android:color/system_accent1_0</color>

    <color name="widget_note_start">@android:color/system_accent3_600</color>
    <color name="widget_note_end">@android:color/system_accent3_700</color>
    <color name="widget_on_note">@android:color/system_accent3_0</color>

    <color name="widget_icon">@android:color/system_neutral1_900</color>
    <color name="widget_icon_accent">@android:color/system_accent1_700</color>
</resources>
