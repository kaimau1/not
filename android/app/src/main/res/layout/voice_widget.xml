<?xml version="1.0" encoding="utf-8"?>
<!-- Sesli Not Asistanı widget'ı: yalnızca bir mikrofon düğmesi. Dokununca
     uygulama doğrudan sesli not yakalama ekranıyla açılır (notlar://voice).

     ponytail: ikon framework VectorDrawable'ı (API 21+); minSdk 23 olduğu
     için RemoteViews'ta güvenli. minSdk 21'in altına inilirse PNG karşılığı
     gerekir. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_mic_background">

    <ImageView
        android:id="@+id/voice_widget_mic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:padding="17dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_mic"
        android:contentDescription="@string/widget_voice_label" />
</FrameLayout>
