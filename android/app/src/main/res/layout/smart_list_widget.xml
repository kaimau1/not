<?xml version="1.0" encoding="utf-8"?>
<!-- Akıllı Liste ana ekran aracı (AL-6 / P97): başlık, kalan sayaç, "+" hızlı
     ekle düğmesi ve en fazla beş işaretlenmemiş madde. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/smart_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/smart_list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_smart_list_label"
            android:textStyle="bold"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_on_surface" />

        <TextView
            android:id="@+id/smart_list_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="12sp"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_muted" />

        <!-- Hızlı ekle "+": 24dp glif + 10dp dolgu = 44dp dokunma hedefi. -->
        <ImageView
            android:id="@+id/smart_list_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/widget_mic_button"
            android:tint="@color/widget_on_accent"
            android:src="@drawable/ic_hizli_ekle"
            android:contentDescription="@string/hizli_ekle" />
    </LinearLayout>

    <TextView
        android:id="@+id/smart_list_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/widget_smart_list_empty"
        android:textSize="13sp"
        android:visibility="gone"
        android:textColor="@color/widget_on_surface_muted" />

    <TextView
        android:id="@+id/smart_list_row_1"
        style="@style/WidgetNoteRow"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/smart_list_row_2"
        style="@style/WidgetNoteRow" />

    <TextView
        android:id="@+id/smart_list_row_3"
        style="@style/WidgetNoteRow" />

    <TextView
        android:id="@+id/smart_list_row_4"
        style="@style/WidgetNoteRow" />

    <TextView
        android:id="@+id/smart_list_row_5"
        style="@style/WidgetNoteRow" />

    <TextView
        android:id="@+id/smart_list_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingLeft="12dp"
        android:textSize="12sp"
        android:visibility="gone"
        android:textColor="@color/widget_on_surface_muted" />
</LinearLayout>
