<?xml version="1.0" encoding="utf-8"?>
<!-- Koyu tema karşılığı: aynı marka rengi ama daha derin, böylece koyu
     duvar kâğıdında parlamaz. Kenar hattı biraz daha güçlü, çünkü koyu
     zeminde widget'ın sınırı yoksa yüzer gibi durmuyor. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#232C7A"
                android:startColor="#4655C4"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
