<?xml version="1.0" encoding="utf-8"?>
<!-- Koyu tema karşılığı: aynı yeşil ama daha derin, koyu duvar kâğıdında
     parlamasın diye. Kenar hattı biraz daha güçlü. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#1B633E"
                android:startColor="#2E9E63"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
