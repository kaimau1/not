<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- router.dart › notlar://ekle — ana ekranın ⚡ Hızlı ekle levhası
         (KARAR PLAN 1.0b P2, 2026-11-20). İLK SIRADA: çoğu başlatıcı ilk 4
         kısayolu gösterir; "Kalemle yaz" 5. sıraya düştü. -->
    <shortcut
        android:shortcutId="quick_add"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_add"
        android:shortcutShortLabel="@string/shortcut_quick_add_short"
        android:shortcutLongLabel="@string/shortcut_quick_add_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="notlar://ekle"
            android:targetPackage="dev.kaimau.notlar"
            android:targetClass="dev.kaimau.notlar.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="voice_note"
        android:enabled="true"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="notlar://voice"
            android:targetPackage="dev.kaimau.notlar"
            android:targetClass="dev.kaimau.notlar.MainActivity" />
    </shortcut>
    <!-- router.dart › notlar://new?type=… (Hızlı Eylemler widget'ıyla aynı yol) -->
    <shortcut
        android:shortcutId="new_note"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_edit"
        android:shortcutShortLabel="@string/widget_qa_new_note">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="notlar://new?type=text"
            android:targetPackage="dev.kaimau.notlar"
            android:targetClass="dev.kaimau.notlar.MainActivity" />
    </shortcut>
    <!-- router.dart › notlar://new?type=… (Hızlı Eylemler widget'ıyla aynı yol) -->
    <shortcut
        android:shortcutId="new_checklist"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_agenda"
        android:shortcutShortLabel="@string/widget_qa_checklist">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="notlar://new?type=checklist"
            android:targetPackage="dev.kaimau.notlar"
            android:targetClass="dev.kaimau.notlar.MainActivity" />
    </shortcut>
    <!-- router.dart › notlar://new?type=draw: boş not "Sayfaya yaz (kalem)" kipinde -->
    <shortcut
        android:shortcutId="new_pen"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_edit"
        android:shortcutShortLabel="@string/shortcut_pen_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="notlar://new?type=draw"
            android:targetPackage="dev.kaimau.notlar"
            android:targetClass="dev.kaimau.notlar.MainActivity" />
    </shortcut>
</shortcuts>
