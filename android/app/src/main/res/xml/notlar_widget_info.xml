<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis=0: veriler zaten uygulama tarafından (WidgetService)
     anında itilir; periyodik uyanma yalnızca pil harcıyordu. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/notlar_widget"
    android:previewLayout="@layout/notlar_widget"
    android:description="@string/widget_notes_desc"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
