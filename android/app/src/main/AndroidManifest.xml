<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Hatırlatıcılar dakikası dakikasına çalmalı. Bu izin olmadan
         AlarmManager "inexact" moda düşer ve Android alarmı toplu iş olarak
         dakikalarca geciktirir (9:00 hatırlatıcısı 9:02'de geliyordu).
         USE_EXACT_ALARM BİLEREK YOK (F1.3, 2026-10-19): Play onu yalnız
         alarm/takvim uygulamalarına izin veriyor. SCHEDULE_EXACT_ALARM
         Android 14+'ta varsayılan kapalı olabilir; izin yoksa
         ReminderService inexact'e düşer (exact_alarms_not_permitted). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Görüntülü not: kamerayla video/fotoğraf çekimi. Kamera zorunlu değil
         (tabletlerde olmayabilir), bu yüzden required=false. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Konum hatırlatıcısı (PlaceReminders.kt): yere varınca/ayrılınca
         bildirim. Konumu uygulama değil sistemin geofence hizmeti izler;
         uygulama kapalıyken tetik için "her zaman" izni şart. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Not kilidi (parmak izi/yüz) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- allowBackup=false: kota sayacı gibi yerel veriler ve Keystore'a bağlı
         şifreli kayıtlar cihaz yedeğine girmez; geri yüklemede çözülemeyen
         (bozuk) secure-storage verisi ve veri sızıntısı riski kapanır. -->
    <application
        android:label="Notlar"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <!-- İTME BİLDİRİMİ (FCM, F4.6): uygulama kapalıyken sistemin
             gösterdiği bildirimin küçük simgesi (beyaz siluet) ve kanalı —
             yerel paylaşım bildirimleriyle aynı kanal. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notlar" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="shared_folders" />
        <!-- QR/barkod ve metin tanıma (OCR) modelleri Play Hizmetleri'nden
             gelir (gradle.properties → mobile_scanner.useUnbundled ve
             app/build.gradle.kts → play-services-mlkit-text-recognition;
             APK'dan ~5,6 + ~12 MB düştü). Bu satır modellerin uygulama
             KURULURKEN indirilmesini ister; yoksa ilk kullanımda indirme
             beklenirdi. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode,ocr" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- FLUTTER'IN KENDİ DERİN BAĞLANTI YÖNLENDİRMESİ KAPALI.
                 KÖK NEDEN (kullanıcı bulgusu 2026-09-29, ekran görüntüsü:
                 "GoException: no routes for location: content://0@com.whatsapp
                 .provider.media/item/…"): Flutter 3.27'den beri VIEW
                 intent'inin adresini doğrudan yönlendiriciye (GoRouter) sayfa
                 adresi diye veriyor. "Birlikte aç" ile gelen PDF'in content://
                 adresi bir sayfa olmadığından uygulama "Page Not Found" ile
                 açılıyor, ana ekran hiç kurulmadığı için paylaşım da
                 işlenmiyordu. İntent'leri zaten iki eklenti işliyor:
                 notlar:// bağlantılarını app_links (router.dart →
                 deepLinkHandlerProvider), dosya/metin paylaşımını
                 receive_sharing_intent (share_intake.dart). app_links'in
                 kurulum yönergesi de bu bayrağı false istiyor. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- notlar:// derin bağlantıları (widget mikrofonu, kısayollar).
                 BROWSABLE BİLEREK YOK: widget/kısayol intent'leri explicit
                 (targetClass ile) olduğundan filtreye ihtiyaç duymaz; BROWSABLE
                 ise herhangi bir web sayfasının <a href="notlar://voice"> ile
                 uygulamayı öne getirip SES KAYDINI başlatmasına izin
                 veriyordu. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="notlar"/>
            </intent-filter>
            <!-- Paylaş menüsünden not alma: metin/link, görsel, PDF ve sunum.
                 Yalnız uygulamanın gerçekten işleyebildiği türler listelenir —
                 `*/*` yazılsaydı Notlar her dosyada çıkıp docx/zip paylaşımında
                 boş not açardı. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <!-- Galeriden/kameradan video paylaşımı da nota girer (video
                     cihazda kalır, buluta yüklenmez). -->
                <data android:mimeType="video/*"/>
                <!-- SES DOSYASI (2026-10-17): sohbet uygulamasının sesli
                     mesajı ya da kayıt uygulamasının dosyası nota ses eki
                     olarak girer, sonra metne dökülebilir. -->
                <data android:mimeType="audio/*"/>
            </intent-filter>
            <!-- "Birlikte aç" (ACTION_VIEW) ile PDF/sunum açma. SEND filtresi
                 yalnız PAYLAŞ menüsünde çıkarıyordu; dosya yöneticisinden,
                 indirilenlerden ya da bir sohbet uygulamasının eki üzerinden
                 açarken Notlar listede görünmüyordu (kullanıcı bulgusu
                 2026-08-08: "PDF'yi PDF görüntüleyicilerde açabiliyorum ama
                 Notlar çıkmıyor"). Notlar'ın gönderdiği belge böylece karşı
                 tarafta doğrudan Notlar'da, balonlarıyla açılabiliyor
                 (bkz. PdfEdit.readSharedPdf).

                 BROWSABLE YOK: bir web sayfasının bağlantısı uygulamayı
                 açıp not oluşturamamalı (notlar:// filtresindeki aynı gerekçe).
                 Tür listesi dar tutuluyor — `*/*` Notlar'ı her dosyada
                 çıkarırdı. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <!-- Galeriden/kameradan video paylaşımı da nota girer (video
                     cihazda kalır, buluta yüklenmez). -->
                <data android:mimeType="video/*"/>
                <!-- SES DOSYASI (2026-10-17): sohbet uygulamasının sesli
                     mesajı ya da kayıt uygulamasının dosyası nota ses eki
                     olarak girer, sonra metne dökülebilir. -->
                <data android:mimeType="audio/*"/>
            </intent-filter>
            <!-- BİRDEN ÇOK BELGE paylaşımı (kullanıcı bulgusu 2026-09-05:
                 "PDF'leri paylaşırken Notlar uygulaması çıkmalı" — ekran
                 görüntüsündeki paylaşım levhası "3 dosya paylaşılıyor"
                 diyordu). Tek dosyada SEND filtresi vardı ama Android çoklu
                 seçimde SEND_MULTIPLE gönderiyor ve o filtre yalnız
                 `image/*` için tanımlıydı: birden çok PDF paylaşılınca Notlar
                 listede hiç görünmüyordu. Türler yine dar tutuluyor
                 (`*/*` Notlar'ı her dosyada çıkarırdı). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/*"/>
            </intent-filter>
            <!-- NOT PAKETİ (.notpaket): başka bir Not kullanıcısının gönderdiği
                 not; ekleri, sayfa notları, çizimleri ve PDF balonlarıyla
                 birlikte açılır (bkz. note_package.dart).

                 İki filtre gerekiyor çünkü paket iki yoldan gelebiliyor:
                 * VIEW + pathPattern — dosya yöneticisinden/indirilenlerden
                   "birlikte aç". Uzantıya bakar, MIME'a değil: .notpaket'in
                   kayıtlı bir MIME türü yok.
                 * SEND + application/zip — paylaş menüsünden. YALNIZ zip:
                   `application/octet-stream` yazılsaydı Notlar TANIMSIZ HER
                   dosya türünde paylaş menüsünde çıkardı (yukarıdaki `*/*`
                   uyarısının aynısı). Paket zaten zip olarak paylaşılıyor.

                 Dosya gerçekten paket değilse çalışma anında anlaşılır ve
                 normal paylaşım yoluna düşülür (bkz. share_intake.dart). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:mimeType="*/*"/>
                <data android:pathPattern=".*\\.notpaket"/>
                <data android:pathPattern=".*\\..*\\.notpaket"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/zip"/>
            </intent-filter>
            <meta-data android:name="android.app.shortcuts"
                android:resource="@xml/app_shortcuts" />
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Hatırlatıcı bildirimleri (flutter_local_notifications) -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Ana ekran widget'ı: son notlar -->
        <receiver android:name=".NotlarWidgetProvider"
            android:exported="true"
            android:label="Notlar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/notlar_widget_info" />
        </receiver>

        <!-- Sesli Not Asistanı widget'ı: tek mikrofon düğmesi -->
        <receiver android:name=".VoiceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_voice_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/voice_widget_info" />
        </receiver>

        <!-- Hızlı Eylemler widget'ı: yeni not / liste / sıralı liste / sesli not -->
        <receiver android:name=".QuickActionsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_quick_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/quick_actions_widget_info" />
        </receiver>

        <!-- Konum hatırlatıcısı: geofence tetiği + yeniden başlatmada geri kurma -->
        <receiver android:name=".PlaceReminderReceiver"
            android:exported="false" />
        <receiver android:name=".PlaceBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Bugün widget'ı: bugünün hatırlatıcıları -->
        <receiver android:name=".TodayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- Hızlı Not widget'ı: tek dokunuşla yeni metin notu -->
        <receiver android:name=".QuickNoteWidgetProvider"
            android:exported="true"
            android:label="@string/widget_quicknote_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/quick_note_widget_info" />
        </receiver>
        <!-- "Eki kopyala" (pasteboard eklentisi): görseli cache'e yazıp
             ${packageName}.provider yetkili FileProvider URI'siyle panoya
             koyuyor. Bu provider OLMADAN getUriForFile her seferinde
             IllegalArgumentException atıyor ve Android'de sistem panosuna
             görsel kopyalama sessizce hiç çalışmıyordu (uygulama yine de
             "kopyalandı" diyordu). Eklenti cacheDir'e yazdığı için yol
             tanımı cache-path olmalı. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Cihazın konuşma tanıma servisini görebilmek için (Android 11+
             paket görünürlüğü). Bu olmadan isRecognitionAvailable() servis
             kurulu olsa bile false döner ve dikte eski ses yoluna düşer. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- EKOSİSTEM: kardeş uygulama Dosya Okuyucu kuruluysa dosya seçimi
             doğrudan onun seçicisinde (istenen türe süzülmüş) açılır — bkz.
             MainActivity.pickDocuments. Android 11+ paket görünürlüğü olmadan
             kurulu olsa bile görünmez. -->
        <package android:name="com.dosyaokuyucu.dosya_okuyucu"/>
    </queries>
</manifest>
